                "exec": [
                  "pm.test(\"Tạo booking thành công (Status 200)\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Tên khách hàng khớp với dữ liệu đầu vào\", function () {\r\n    var jsonData = pm.response.json();\r\n    \r\n    // Tự động lấy tên từ file CSV (nếu chạy Runner có file), \r\n    // nếu không có CSV sẽ tự động lấy tên \"Nhat\" từ tab Body gửi đi\r\n    var expectedFirstName = pm.iterationData.get(\"firstname\") || JSON.parse(pm.request.body.raw).firstname;\r\n\r\n    pm.expect(jsonData.booking.firstname).to.eql(expectedFirstName);\r\n});\r\n\r\n// Lưu bookingid vào Environment\r\nvar jsonData = pm.response.json();\r\npm.environment.set(\"bookingid\", jsonData.bookingid);"
                ]
